# Copy to .env. The app works without an API key using deterministic extractive answers.
SENTINEL_DATABASE_URL=sqlite:///./data/app.db
SENTINEL_UPLOAD_DIR=./data/uploads
SENTINEL_TOP_K=8
SENTINEL_MIN_CONFIDENCE=0.40
# Optional OpenAI-compatible provider
SENTINEL_LLM_BASE_URL=https://api.openai.com/v1
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_MODEL=gpt-4o-mini
